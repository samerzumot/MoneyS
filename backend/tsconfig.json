  {
    "compilerOptions": {
      "rootDir": "src",
      "outDir": "dist",
      "module": "commonjs",
      "target": "ES2020",
      "lib": ["ES2020"],
      "types": ["node"],
      "sourceMap": true,
      "declaration": true,
      "declarationMap": true,
      "noUncheckedIndexedAccess": true,
      "exactOptionalPropertyTypes": true,
      "strict": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "forceConsistentCasingInFileNames": true,
      "baseUrl": ".",
      "paths": {
        "@prisma/client": ["src/generated/client/client"],
        "@prisma/client/*": ["src/generated/client/*"]
      }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["dist"]
  }
