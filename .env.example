# Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/debt_optimizer
DB_HOST=localhost
DB_PORT=5432
DB_NAME=debt_optimizer
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Plaid API
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_sandbox
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,transactions,liabilities
PLAID_COUNTRY_CODES=US,CA

# OpenAI API (for debt optimization)
OPENAI_API_KEY=your_openai_api_key

# Email Service (SendGrid, Mailgun, etc.)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your_email_api_key
EMAIL_FROM=noreply@debtoptimizer.com

# JWT Secret for session management
JWT_SECRET=your_jwt_secret_key_change_this

# Frontend URL
CLIENT_URL=http://localhost:3000
